#include <stdio.h>

#define QTD_COLUNAS 3

/* ---------- Funções auxiliares ---------- */

void trocar(int *a, int *b) {
    int aux = *a;
    *a = *b;
    *b = aux;
}

int divisivelPorAlgumPrimo(int n, int primos[], int qtd) {
    int i;
    for (i = 0; i < qtd; i++) {
        if (n % primos[i] == 0) {
            return 1;
        }
    }
    return 0;
}

int maiorDaLinha(int linha[], int col) {
    int i, maior = linha[0];
    for (i = 1; i < col; i++) {
        if (linha[i] > maior) {
            maior = linha[i];
        }
    }
    return maior;
}



/* ---------- d. maiorPorLinha ---------- */

void maiorPorLinha(int m[][QTD_COLUNAS], int lin, int col, int v[]) {
    int i;
    for (i = 0; i < lin; i++) {
        v[i] = maiorDaLinha(m[i], col);
    }
}

