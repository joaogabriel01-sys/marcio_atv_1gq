#include <stdio.h>

#define QTD_COLUNAS 3

/* ---------- Funções auxiliares ---------- */

void trocar(int *a, int *b) {
    int aux = *a;
    *a = *b;
    *b = aux;
}

int divisivelPorAlgumPrimo(int n, int primos[], int qtd) {
    int i;
    for (i = 0; i < qtd; i++) {
        if (n % primos[i] == 0) {
            return 1;
        }
    }
    return 0;
}

int maiorDaLinha(int linha[], int col) {
    int i, maior = linha[0];
    for (i = 1; i < col; i++) {
        if (linha[i] > maior) {
            maior = linha[i];
        }
    }
    return maior;
}

void inverterTrecho(char str[], int ini, int fim) {
    char aux;
    while (ini < fim) {
        aux = str[ini];
        str[ini] = str[fim];
        str[fim] = aux;
        ini++;
        fim--;
    }
}

/* ---------- a. removerRepetidos ---------- */

int removerRepetidos(int v[], int tam) {
    int i, novoTam;

    if (tam == 0) {
        return 0;
    }

    novoTam = 1;
    for (i = 1; i < tam; i++) {
        if (v[i] != v[novoTam - 1]) {
            v[novoTam] = v[i];
            novoTam++;
        }
    }
    return novoTam;
}

/* ---------- b. ordenar (bubble sort) ---------- */

void ordenar(int v[], int tam) {
    int i, j, trocou;

    for (i = 0; i < tam - 1; i++) {
        trocou = 0;
        for (j = 0; j < tam - 1 - i; j++) {
            if (v[j] > v[j + 1]) {
                trocar(&v[j], &v[j + 1]);
                trocou = 1;
            }
        }
        if (!trocou) {
            break;
        }
    }
}

/* ---------- c. preencherPrimos ---------- */

void preencherPrimos(int v[], int tam) {
    int qtd = 0;
    int candidato = 2;

    while (qtd < tam) {
        if (!divisivelPorAlgumPrimo(candidato, v, qtd)) {
            v[qtd] = candidato;
            qtd++;
        }
        candidato++;
    }
}

/* ---------- d. maiorPorLinha ---------- */

void maiorPorLinha(int m[][QTD_COLUNAS], int lin, int col, int v[]) {
    int i;
    for (i = 0; i < lin; i++) {
        v[i] = maiorDaLinha(m[i], col);
    }
}

/* ---------- e. inverterPalavras ---------- */

void inverterPalavras(char str[]) {
    int i = 0, ini;

    while (str[i] != '\0') {
        if (str[i] != ' ') {
            ini = i;
            while (str[i] != '\0' && str[i] != ' ') {
                i++;
            }
            inverterTrecho(str, ini, i - 1);
        } else {
            i++;
        }
    }
}

/* ---------- main de teste ---------- */

void imprimirVetor(int v[], int tam) {
    int i;
    for (i = 0; i < tam; i++) {
        printf("%d ", v[i]);
    }
    printf("\n");
}

int main() {
    int a[] = {3, 3, 4, 5, 6, 6, 6, 7};
    int b[] = {9, 2, 7, 1, 5};
    int primos[5];
    int m[2][QTD_COLUNAS] = {{10, 5, 20}, {1, 8, 3}};
    int maiores[2];
    char frase[] = "o rato roeu";
    int novoTam;

    novoTam = removerRepetidos(a, 8);
    printf("a) tamanho %d: ", novoTam);
    imprimirVetor(a, novoTam);

    ordenar(b, 5);
    printf("b) ");
    imprimirVetor(b, 5);

    preencherPrimos(primos, 5);
    printf("c) ");
    imprimirVetor(primos, 5);

    maiorPorLinha(m, 2, QTD_COLUNAS, maiores);
    printf("d) ");
    imprimirVetor(maiores, 2);

    inverterPalavras(frase);
    printf("e) %s\n", frase);

    return 0;
}